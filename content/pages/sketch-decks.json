    "text_011": "look closer +",
    "text_012": "At the table:",
    "text_013": " Client + PM",
    "text_014": "On the desk:",
    "text_015": " Goal / audience / constraints",
    "text_016": "Before moving on:",
    "text_017": " What does success mean?",
    "text_018": "02 /",
    "text_019": "Brief + scope",
    "text_020": "Turn the call into an agreement.",
    "text_021": "look closer +",
    "text_022": "At the table:",
    "text_023": " PM + approver",
    "text_024": "On the desk:",
    "text_025": " Deliverables / exclusions / inputs",
    "text_026": "Before moving on:",
    "text_027": " Has the direction been agreed?",
    "text_028": "03 /",
    "text_029": "Map the route",
    "text_030": "Break the work into useful pieces.",
    "text_031": "look closer +",
    "text_032": "At the table:",
    "text_033": " PM + contributors",
