    "text_035": " Milestones / owners / dependencies",
    "text_036": "Before moving on:",
    "text_037": " What could block the next step?",
    "text_038": "04 /",
    "text_039": "Make + coordinate",
    "text_040": "Give the work a visible rhythm.",
    "text_041": "look closer +",
    "text_042": "At the table:",
    "text_043": " Contributors + PM",
    "text_044": "On the desk:",
    "text_045": " Working links / updates / decisions",
    "text_046": "Before moving on:",
    "text_047": " Does everyone have the current context?",
    "text_048": "05 /",
    "text_049": "Review + revise",
    "text_050": "Collect feedback. Resolve contradictions.",
    "text_051": "look closer +",
    "text_052": "At the table:",
    "text_053": " Reviewer + PM + team",
    "text_054": "On the desk:",
    "text_055": " One review log / approved direction",
    "text_056": "Before moving on:",
    "text_057": " Approved? Move on. If not, revise.",
